coverage_report_bkp/
# Generated coverage reports: published as CI artifacts / GitHub Pages, never
# committed (bin/run_tests.py --cov-report regenerates the whole tree).
coverage_report/
# The regression document a batch leaves beside the logs it describes
# (bin/regression_report.py); the published copy lives in the gitignored
# coverage_report/regression/, and both are uploaded as CI artifacts.
sim/*/regression_results.json
# Scratch directory for ad-hoc tooling experiments; it carries its own private
# package tree (log_agent/pylibs) that venv* below does not match, and nothing in
# the repository may import from it.
/log_agent/
# Local coverage report generation artifacts (regenerated by bin/run_tests.py,
# and written beside the current directory by the two converters when they are
# run by hand without -o)
/cobertura.xml
/coverage.html
/merged.xml
/merged.ucis.xml
/report.xml
/metrics.db
/transcript
# The Spike disassembler clone this checkout makes at the top level. The
# pattern above needs a parent directory, so it only matches a nested one.
/vendor_lib/dpi_dasm_spike/
