<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal stand-in for a full-hierarchy `vcover report -xml` rollup of a
     merged .ucdb, used by bin/tests/test_converters.py.

     The element and attribute names are Questa's (the layout is documented at
     the top of bin/questa_xml_to_cobertura.py); the numbers are invented, small
     and self-consistent: every count here matches the statement, branch and
     condition items of the companion fixture questa_detail.xml, which is exactly
     what the converters' rollup-vs-detail cross-check compares.

     __REPO__ is replaced with the repository root by the test, because Questa
     writes the compile host's absolute source paths and making them relative to
     the checkout is part of what the converters have to get right. -->
<coverage_report questa_version="2025.3" command="vcover report -xml">
  <code_coverage_report byInstance="1">
    <instanceData path="/uvmt_cv32e20_tb/dut_wrap/cv32e20_top_i/u_cve2_top/u_cve2_core/alu_i"
                  du="cve2_alu">
      <statements active="3" hits="2" percent="66.67"/>
      <branches active="2" hits="1" percent="50.00"/>
      <fec_conditions active="1" hits="1" percent="100.00"/>
      <states active="2" hits="1" percent="50.00"/>
      <transitions active="3" hits="1" percent="33.33"/>
      <assertion_successes active="1" hits="1" percent="100.00"/>
      <cover_directives active="1" hits="0" percent="0.00"/>
    </instanceData>
    <!-- Covergroup rollups hang off the package, outside the DUT instance, which
         is why the functional-coverage export must not be -instance restricted
         (see parse_questa_functional_rollup() in bin/run_tests.py). -->
    <instanceData path="/uvme_cv32e20_pkg">
      <cover_group_types active="2" hits="1" percent="50.00"/>
      <coverpoints_crosses active="3" hits="2" percent="66.67"/>
      <cvgbins active="10" hits="4" percent="40.00"/>
    </instanceData>
  </code_coverage_report>
</coverage_report>
